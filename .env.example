# Data pipeline settings (all optional). Export them in your shell or CI before `npm run data -- ...`.
HYVAEP_DB=data/hyvaep.db
HYVAEP_EXPORT_DIR=src/data
# Nominatim requires an identifying User-Agent; a contact email is recommended for regular use.
HYVAEP_USER_AGENT=hyvaep-dashboard-data-pipeline/0.1
NOMINATIM_EMAIL=
# Point these at your own instances for production use (the public OSRM server is a demo).
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
STATFIN_URL=https://pxdata.stat.fi/PxWeb/api/v1/fi/StatFin
SOTKANET_URL=https://sotkanet.fi/rest/1.1
